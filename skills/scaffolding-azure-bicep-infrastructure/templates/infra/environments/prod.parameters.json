{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "org": {
      "value": "myorg"
    },
    "project": {
      "value": "myapp"
    },
    "environmentName": {
      "value": "prod"
    },
    "location": {
      "value": "australiaeast"
    },
    "sqlAdminLogin": {
      "value": "sqladmin"
    },
    "deploySql": {
      "value": true
    },
    "deployStorage": {
      "value": false
    },
    "deployObservability": {
      "value": true
    },
    "sqlSku": {
      "value": "Serverless"
    },
    "alertEmail": {
      "value": "ops@example.com"
    }
  }
}
